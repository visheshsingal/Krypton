{
  "manifest_version": 3,
  "name": "Krypton AI Security",
  "description": "Locally detects sensitive data in AI prompts for authorized Krypton users.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://krypton-ten-theta.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Krypton AI Security",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.bing.com/*",
        "https://www.perplexity.ai/*",
        "https://*.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
